{
  "name": "@typeonce/ritmo-pixi",
  "version": "0.5.0",
  "description": "Pixi container adapter for Ritmo render-node registries",
  "author": "Sandro Maglione",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandroMaglione/bevy-ts.git",
    "directory": "packages/pixi"
  },
  "bugs": {
    "url": "https://github.com/SandroMaglione/bevy-ts/issues"
  },
  "homepage": "https://sandromaglione.github.io/bevy-ts/",
  "keywords": [
    "ecs",
    "gamedev",
    "ritmo",
    "pixi",
    "pixijs",
    "rendering"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "src/**/*.ts",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./internal/*": null,
    "./*/index": null
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      },
      "./internal/*": null,
      "./*/index": null
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --pretty false",
    "check": "tsc -b tsconfig.json --pretty false"
  },
  "dependencies": {
    "@typeonce/ritmo-render": "workspace:^"
  },
  "devDependencies": {
    "@typeonce/ritmo": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
