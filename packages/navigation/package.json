{
  "name": "@typeonce/bevy-ts-navigation",
  "version": "0.4.0",
  "description": "Immutable 2D grids and bounded multi-goal shortest-path fields for games",
  "author": "Sandro Maglione",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandroMaglione/bevy-ts.git",
    "directory": "packages/navigation"
  },
  "bugs": { "url": "https://github.com/SandroMaglione/bevy-ts/issues" },
  "homepage": "https://sandromaglione.github.io/bevy-ts/",
  "keywords": ["ecs", "gamedev", "bevy", "navigation", "pathfinding"],
  "type": "module",
  "sideEffects": false,
  "files": ["src/**/*.ts", "dist", "README.md", "LICENSE"],
  "exports": {
    "./package.json": "./package.json",
    ".": { "types": "./src/index.ts", "import": "./src/index.ts" },
    "./*": { "types": "./src/*.ts", "import": "./src/*.ts" },
    "./internal/*": null,
    "./*/index": null
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
      "./*": { "types": "./dist/*.d.ts", "import": "./dist/*.js" },
      "./internal/*": null,
      "./*/index": null
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --pretty false",
    "check": "tsc -b tsconfig.json --pretty false"
  },
  "dependencies": { "@typeonce/bevy-ts": "workspace:^" },
  "engines": { "node": ">=20" }
}
