{
  "name": "@typeonce/bevy-ts",
  "version": "0.2.0",
  "description": "Type-safe, game-loop-agnostic ECS runtime for TypeScript, inspired by Bevy",
  "author": "Sandro Maglione",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandroMaglione/bevy-ts.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/SandroMaglione/bevy-ts/issues"
  },
  "homepage": "https://sandromaglione.github.io/bevy-ts/",
  "keywords": [
    "ecs",
    "entity-component-system",
    "game-engine",
    "gamedev",
    "bevy",
    "typescript",
    "type-safe"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "src/**/*.ts",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./internal/*": null,
    "./*/index": null
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      },
      "./internal/*": null,
      "./*/index": null
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --pretty false",
    "check": "tsc -b tsconfig.json --pretty false"
  },
  "peerDependencies": {
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
