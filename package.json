{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "vitest run",
    "test-types": "TSTYCHE_STORE_PATH=.tstyche TSTYCHE_TYPESCRIPT_MODULE=typescript tstyche",
    "check": "pnpm typecheck && pnpm test-types && pnpm test",
    "coverage": "vitest --coverage",
    "docs:generate": "node --import tsx scripts/docs.ts",
    "docs:dev": "pnpm docs:generate && vite docs --host",
    "docs:build": "pnpm docs:generate",
    "docs:preview": "vite docs --host",
    "docs:check": "pnpm docs:generate && git diff --exit-code -- docs",
    "example:genetics": "vite --open /examples/genetics/",
    "example:pixi": "vite --open /examples/pixi/",
    "example:platformer": "vite --open /examples/platformer/",
    "example:top-down": "vite --open /examples/top-down/"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-beta.43",
    "@types/markdown-it": "^14.1.2",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^25.5.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/expect": "4.0.18",
    "effect": "4.0.0-beta.43",
    "lightningcss": "1.32.0",
    "markdown-it": "^14.1.1",
    "matter-js": "^0.20.0",
    "pixi.js": "^8.17.1",
    "shiki": "^4.0.2",
    "tstyche": "7.2.3",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  }
}
