{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "references": [{ "path": "./tsconfig.packages.json" }],
  "include": [
    "scripts/**/*.ts",
    "examples/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/dtslint/**/*.ts",
    "packages/*/bench/**/*.ts",
    "**/vite.config.ts",
    "**/vitest.config.ts",
    "vitest.shared.ts"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "erasableSyntaxOnly": false,
    "types": ["node"],
    "paths": {
      "@bevy-ts/core": ["./packages/core/src/index.ts"],
      "@bevy-ts/core/*": ["./packages/core/src/*"],
      "@bevy-ts/browser": ["./packages/browser/src/index.ts"],
      "@bevy-ts/browser/*": ["./packages/browser/src/*"],
      "@bevy-ts/pixi": ["./packages/pixi/src/index.ts"],
      "@bevy-ts/pixi/*": ["./packages/pixi/src/*"],
      "@bevy-ts/math": ["./packages/math/src/index.ts"],
      "@bevy-ts/math/*": ["./packages/math/src/*"],
      "@bevy-ts/devtools": ["./packages/devtools/src/index.ts"],
      "@bevy-ts/devtools/*": ["./packages/devtools/src/*"]
    }
  }
}
